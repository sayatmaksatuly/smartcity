# Optional. Leave blank for honest local, non-AI recommendations.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Shared, per-process recommendation/chat quota; two concurrent calls maximum.
GENERATION_REQUESTS_PER_MINUTE=30
# Optional: real walking routes require an openrouteservice account API key.
# Backend only. Never place this key in VITE_* or a frontend environment file.
ORS_API_KEY=
ORS_TIMEOUT_SECONDS=15
ORS_REQUESTS_PER_MINUTE=20
# Personal data currently uses the browser Supabase client with PostgreSQL RLS.
# These public backend placeholders are reserved; no service-role key is required.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Default database: backend/data/astana.db (independent of working directory).
# DATABASE_URL=sqlite:///C:/path/to/aitu-kerek-smartcity/backend/data/astana.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
OVERPASS_ENDPOINTS=["https://overpass-api.de/api/interpreter","https://overpass.kumi.systems/api/interpreter"]
