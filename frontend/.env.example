# Public frontend configuration. Never use a secret or service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional custom raster tile provider; set BOTH URL template and required attribution.
# Leave both empty to use OpenStreetMap's default tiles and attribution.
VITE_TILE_URL=
VITE_TILE_ATTRIBUTION=
